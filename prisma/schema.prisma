generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         String   @default("STUDENT")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  enrollments         Enrollment[]
  assignmentProgress  AssignmentProgress[]
  taughtCourses       Course[]           @relation("CourseLecturer")
  uploadedMaterials   CourseMaterial[]
  announcements       Announcement[]
}

model Application {
  id        String   @id @default(cuid())
  fullName  String
  email     String
  phone     String
  program   String
  status    String   @default("PENDING")
  createdAt DateTime @default(now())
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  message   String
  createdAt DateTime @default(now())
}

model Course {
  id          String           @id @default(cuid())
  code        String
  title       String
  lecturerId  String?
  lecturer    User?            @relation("CourseLecturer", fields: [lecturerId], references: [id], onDelete: SetNull)
  enrollments Enrollment[]
  assignments Assignment[]
  materials   CourseMaterial[]
  announcements Announcement[]
}

model Announcement {
  id        String   @id @default(cuid())
  courseId  String
  authorId  String
  title     String
  body      String
  createdAt DateTime @default(now())
  course    Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  author    User   @relation(fields: [authorId], references: [id], onDelete: Cascade)
}

model CourseMaterial {
  id            String   @id @default(cuid())
  courseId      String
  title         String
  fileName      String
  storedPath    String
  mimeType      String?
  sizeBytes     Int
  uploadedById  String
  createdAt     DateTime @default(now())
  course        Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  uploadedBy    User     @relation(fields: [uploadedById], references: [id], onDelete: Cascade)
}

model Enrollment {
  id       String @id @default(cuid())
  userId   String
  courseId String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
}

model Assignment {
  id          String   @id @default(cuid())
  courseId    String
  title       String
  description String?
  maxPoints   Int      @default(100)
  dueDate     DateTime
  createdAt   DateTime @default(now())
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  progress    AssignmentProgress[]
}

model AssignmentProgress {
  id                   String      @id @default(cuid())
  userId               String
  assignmentId         String
  status               String      @default("PENDING")
  grade                Int?
  submittedAt          DateTime?
  submissionStoredPath String?
  submissionFileName   String?
  feedback             String?
  user                 User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignment           Assignment  @relation(fields: [assignmentId], references: [id], onDelete: Cascade)

  @@unique([userId, assignmentId])
}
