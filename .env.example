DATABASE_URL="file:./dev.db"
JWT_SECRET="generate-a-long-secret-for-production"

# Public Moodle launch URL — student/lecturer portals link here for all teaching & assessment.
NEXT_PUBLIC_MOODLE_URL="https://lms.example.edu"

# Optional: custom Google Maps embed URL for the contact page campus map
# NEXT_PUBLIC_CAMPUS_MAP_EMBED_URL="https://www.google.com/maps/embed?pb=..."

# Outbound transactional email (optional). Without these, Admit/Enrollment still notify applicants in-portal while dev prints `[mail:skipped:no-resend]`.
RESEND_API_KEY=""
MAIL_FROM="MUoT Admissions <onboarding@your-resend-domain.com>"
